# คัดลอกเป็น .env.local สำหรับรันบนเครื่อง (บน Vercel ระบบจะใส่ DATABASE_URL ให้เองเมื่อเชื่อม Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# (แนะนำ) ข้อความลับยาวๆ สำหรับเซ็นคุกกี้ล็อกอิน ถ้าไม่ใส่จะใช้ DATABASE_URL แทน
# เปลี่ยนค่านี้ = ทุกคนถูกออกจากระบบ
AUTH_SECRET=
